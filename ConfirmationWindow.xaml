<Window x:Class="RB4ShadPS4Installer.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="76" /></Grid.RowDefinitions>
            <Border Background="#1B202A" CornerRadius="14,14,0,0" MouseLeftButtonDown="DragHeader">
                <Grid Margin="18,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="WindowTitleText" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="×" Width="36" Height="36" FontSize="22" Background="Transparent"
                            BorderThickness="0" Foreground="{StaticResource MutedTextBrush}" Click="CancelAction" />
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="30,24,30,24">
                <TextBlock x:Name="HeadingText" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20" />
            </StackPanel>
            <Border Grid.Row="2" Background="#11151C" CornerRadius="0,0,14,14" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="30,0">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="100" IsCancel="True" Click="CancelAction" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Width="145" Margin="10,0,0,0" IsDefault="True" Click="ConfirmAction" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
