<Window x:Class="RB4ShadPS4Installer.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review installation" Width="560" SizeToContent="Height" MinHeight="360" MaxHeight="560"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="76" />
            </Grid.RowDefinitions>

            <Border Background="#1B202A" CornerRadius="14,14,0,0" MouseLeftButtonDown="DragHeader">
                <Grid Margin="18,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="RB" FontWeight="Black" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Review installation" FontWeight="SemiBold" FontSize="15"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Button Grid.Column="2" Content="×" Width="36" Height="36" FontSize="22"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedTextBrush}"
                            Cursor="Hand" Click="CancelInstall" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="410">
                <StackPanel Margin="30,24,30,22">
                    <TextBlock Text="Ready to install" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="Check the destination and selected content before continuing."
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,20" />

                    <Border Background="#10141B" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="115" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Action" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock x:Name="ActionText" Grid.Column="1" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Text="Region" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,11,0,0" />
                            <TextBlock x:Name="RegionText" Grid.Row="1" Grid.Column="1" Margin="0,11,0,0" />
                            <TextBlock Grid.Row="2" Text="Game folder" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,11,0,0" />
                            <TextBlock x:Name="GameFolderText" Grid.Row="2" Grid.Column="1" Margin="0,11,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="UpdateFolderLabel" Grid.Row="3" Text="Update folder" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,11,0,0" />
                            <TextBlock x:Name="UpdateFolderText" Grid.Row="3" Grid.Column="1" Margin="0,11,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="AddonFolderLabel" Grid.Row="4" Text="Add-on folder" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,11,0,0" />
                            <TextBlock x:Name="AddonFolderText" Grid.Row="4" Grid.Column="1" Margin="0,11,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="ContentLabel" Grid.Row="5" Text="Additional content" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,11,0,0" />
                            <TextBlock x:Name="ContentText" Grid.Row="5" Grid.Column="1" Margin="0,11,0,0" />
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SuccessPanelBrush}" BorderBrush="{StaticResource SuccessBorderBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Preflight checks" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                            <TextBlock x:Name="PreflightText" TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="20" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="WarningsPanel" Background="#2A2314" BorderBrush="#8D6D2E"
                            BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,14,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Attention" Foreground="#F4C966" FontWeight="SemiBold" />
                            <TextBlock x:Name="WarningsText" Foreground="#D8C79F" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#11151C" CornerRadius="0,0,14,14"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="30,0">
                    <TextBlock Text="No source packages will be deleted." Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="100"
                                IsCancel="True" Click="CancelInstall" />
                        <Button Content="Install" Style="{StaticResource PrimaryButton}" Width="120" Margin="10,0,0,0"
                                IsDefault="True" Click="ConfirmInstall" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
