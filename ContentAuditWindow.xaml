<Window x:Class="RB4ShadPS4Installer.ContentAuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installed content audit" Width="780" Height="620"
        MinWidth="700" MinHeight="520" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="72" /></Grid.RowDefinitions>
            <Border Background="#1B202A" CornerRadius="14,14,0,0" MouseLeftButtonDown="DragHeader">
                <Grid Margin="20,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Installed content audit" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="×" Width="36" Height="36" FontSize="22" Background="Transparent"
                            BorderThickness="0" Foreground="{StaticResource MutedTextBrush}" Click="CloseDialog" />
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="28,22,28,18">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock x:Name="HeadingText" FontSize="24" FontWeight="Bold" />
                <TextBlock x:Name="SummaryText" Grid.Row="1" Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,7,0,16" TextWrapping="Wrap" />
                <ListBox x:Name="FindingsList" Grid.Row="2" Background="#0F1219"
                         BorderBrush="{StaticResource PanelBorderBrush}" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SeverityLabel}" Foreground="{Binding SeverityColor}"
                                           FontSize="11" FontWeight="Bold" Margin="0,2,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Folder}" Foreground="#748096" FontSize="10"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Border Grid.Row="2" Background="#11151C" CornerRadius="0,0,14,14"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="28,0">
                    <Button Content="Copy report" Style="{StaticResource SecondaryButton}" Click="CopyReport" />
                    <Button Content="Close" Style="{StaticResource PrimaryButton}" Width="110" Margin="9,0,0,0"
                            IsDefault="True" Click="CloseDialog" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
