<Window x:Class="RB4ShadPS4Installer.CrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RB4 shadPS4 Installer stopped" Width="650" Height="355"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" Topmost="True">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="#F05A72"
            BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="76" />
            </Grid.RowDefinitions>

            <Border Background="#1B202A" CornerRadius="14,14,0,0" MouseLeftButtonDown="DragHeader">
                <Grid Margin="18,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="RB4 shadPS4 Installer" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="×" Width="36" Height="36" FontSize="22"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedTextBrush}"
                            Click="CloseDialog" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="30,24,30,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Width="50" Height="50" CornerRadius="25" Background="#351923"
                        BorderBrush="#F05A72" BorderThickness="1" VerticalAlignment="Top">
                    <TextBlock Text="!" Foreground="#FF7890" FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="The installer ran into an unexpected error" FontSize="22" FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Your game files were not intentionally removed. A local diagnostic report was saved so the problem can be investigated. The application will close after this window."
                               Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" LineHeight="19" />
                    <Border Background="#10141B" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="11" Margin="0,12,0,0">
                        <TextBlock x:Name="ReportPathText" FontSize="12" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Border>
                    <TextBlock Text="The report can contain local paths. Review it before sharing."
                               Foreground="#E7B36C" FontSize="11" Margin="0,7,0,0" />
                    <TextBlock x:Name="ErrorText" Foreground="#F07A8F" FontSize="11" Margin="0,5,0,0"
                               Visibility="Collapsed" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="#11151C" CornerRadius="0,0,14,14"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="30,0">
                    <Button x:Name="OpenReportFolderButton" Content="Open report folder" Style="{StaticResource SecondaryButton}" Click="OpenReportFolder" />
                    <Button Content="Copy details" Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" Click="CopyDetails" />
                    <Button Content="Close installer" Style="{StaticResource PrimaryButton}" Margin="9,0,0,0"
                            IsDefault="True" Click="CloseDialog" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
