<Window x:Class="RB4ShadPS4Installer.CompatibilityReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compatibility report" Width="760" Height="590" MinWidth="650" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Package compatibility report" FontSize="25" FontWeight="Bold" />
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,16" />
        </StackPanel>
        <ListBox x:Name="ItemsList" Grid.Row="1" Background="#0F1219" BorderBrush="{StaticResource PanelBorderBrush}" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate><DataTemplate>
                <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="13">
                    <Grid ToolTip="{Binding Source}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Metadata}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Finding}" Foreground="#E7B36C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" Margin="16,0,0,0" />
                    </Grid>
                </Border>
            </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="PKG metadata is enforced again after extraction." Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            <Button Content="Close" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Width="110" IsDefault="True" Click="CloseWindow" />
        </Grid>
    </Grid>
</Window>
