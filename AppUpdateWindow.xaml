<Window x:Class="RB4ShadPS4Installer.AppUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application update" Width="570" SizeToContent="Height" MinHeight="390" MaxHeight="620"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="78" />
            </Grid.RowDefinitions>

            <Border Background="#1B202A" CornerRadius="14,14,0,0" MouseLeftButtonDown="DragHeader">
                <Grid Margin="18,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Image Source="Assets/app-icon.png" Width="36" Height="36" Stretch="Uniform" />
                    <TextBlock Grid.Column="1" Text="Application update" FontWeight="SemiBold" FontSize="15"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Button Grid.Column="2" Content="×" Width="36" Height="36" FontSize="22"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedTextBrush}"
                            Cursor="Hand" Click="UpdateLater" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="460">
                <StackPanel Margin="30,24,30,22">
                    <TextBlock Text="A new version is ready" FontSize="25" FontWeight="Bold" />
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource SuccessBrush}"
                               FontWeight="SemiBold" Margin="0,7,0,18" />

                    <Border Background="#10141B" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="15">
                        <StackPanel>
                            <TextBlock Text="What's new" FontWeight="SemiBold" />
                            <TextBlock x:Name="ReleaseNotesText" Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SuccessPanelBrush}" BorderBrush="{StaticResource SuccessBorderBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,14,0,0">
                        <TextBlock x:Name="UpdateActionText" TextWrapping="Wrap" LineHeight="19" />
                    </Border>

                    <CheckBox x:Name="DisableAutomaticChecksCheck"
                              Content="Turn off automatic update checks"
                              Margin="2,15,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#11151C" CornerRadius="0,0,14,14"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="30,0">
                    <TextBlock Text="The download will be SHA-256 verified."
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Not now" Style="{StaticResource SecondaryButton}" Width="100"
                                IsCancel="True" Click="UpdateLater" />
                        <Button x:Name="InstallUpdateButton" Content="Update now" Style="{StaticResource PrimaryButton}"
                                Width="150" Margin="10,0,0,0" IsDefault="True" Click="AcceptUpdate" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
